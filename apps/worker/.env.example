# Redis (same for backend and worker)
REDIS_URL=redis://localhost:6379

# Postgres (used via @repo/database for project/conversation updates)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# E2B sandboxes (used to build projects in-place before deploying)
E2B_API_KEY=

# LLM (comma-separated Gemini keys — rotated on rate limits; used to generate project titles)
OPENROUTER_API_KEY=

# App domain (subdomains are <projectId>.APP_DOMAIN)
APP_DOMAIN=app.lovable.nagmani.site

# Project directory inside the sandbox
PROJECT_BASE_PATH=/home/user/project

# Top-level bucket prefix where build artifacts are uploaded
ARTIFACTS_PREFIX=build-artifacts

# Timeouts (ms)
BUILD_TIMEOUT_MS=120000
UPLOAD_TIMEOUT_MS=180000

# Object store (shared config from @repo/storage — same as backend)
# Provider defaults to "s3" when unset.
OBJECT_STORE_PROVIDER=s3

# S3 (used when OBJECT_STORE_PROVIDER=s3)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_CDN_DOMAIN=

# GCS (used when OBJECT_STORE_PROVIDER=gcs)
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_SERVICE_ACCOUNT_KEY=
GCS_SERVICE_ACCOUNT_KEY_PATH=
GCS_CDN_DOMAIN=